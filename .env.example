# 本地服务端口
STYLEME_LOCAL_PORT=8787

# 可选；Codex OAuth 生图等待上限，默认 1200000ms（20 分钟）。
STYLEME_CODEX_IMAGE_TIMEOUT_MS=1200000

# OpenAI Provider 会检测该变量；默认 Mock Provider 不要求填写。
# 不要把 key 写进插件包、文档截图或前端日志。
OPENAI_API_KEY=

# 可选；默认 gpt-image-2。也可以通过 /v1/settings/providers 写入本地服务设置。
OPENAI_IMAGE_MODEL=gpt-image-2

# 可选；默认 gpt-4.1-mini，用于读取参考图并生成图片配方。
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

# 第三方 API 可分别配置生图模型和看图分析模型。
GEMINI_NANO_BANANA_API_KEY=
GEMINI_NANO_BANANA_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_NANO_BANANA_MODEL=gemini-2.5-flash-image
GEMINI_NANO_BANANA_ANALYSIS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
OPENROUTER_ANALYSIS_MODEL=
CUSTOM_PROVIDER_API_KEY=
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_MODEL=
CUSTOM_PROVIDER_ANALYSIS_MODEL=
